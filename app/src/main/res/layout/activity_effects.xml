<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="افکت‌های صوتی (فقط فایل‌ها)"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"
        android:contentDescription="عنوان صفحه افکت‌ها" />

    <EditText
        android:id="@+id/etSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="جستجو: باد، باران، رعد، دریا..."
        android:inputType="text"
        android:imeOptions="actionSearch"
        android:contentDescription="کادر جستجوی نام افکت" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/btnSearch"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="جستجو"
            android:contentDescription="دکمه جستجوی افکت" />

        <Button
            android:id="@+id/btnAddLocal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="افزودن از گوشی"
            android:contentDescription="افزودن فایل افکت از گوشی" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:layout_marginBottom="8dp"
        android:contentDescription="تعداد افکت‌ها" />

    <ListView
        android:id="@+id/listEffects"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:contentDescription="لیست فایل‌های افکت" />

</LinearLayout>
