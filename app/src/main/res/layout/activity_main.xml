<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ضبط صدا -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ضبط صدا"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btnRecord"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/record_start"
                android:contentDescription="دکمه شروع یا توقف ضبط صدا" />

            <Button
                android:id="@+id/btnDeleteRecord"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="@string/record_delete"
                android:enabled="false"
                android:contentDescription="حذف صدای ضبط شده" />
        </LinearLayout>

        <Button
            android:id="@+id/btnUseRecordAsMain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/record_use_as_main"
            android:enabled="false"
            android:layout_marginBottom="16dp"
            android:contentDescription="استفاده از صدای ضبط شده به عنوان فایل اصلی" />

        <TextView
            android:id="@+id/tvRecordStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:contentDescription="وضعیت ضبط" />

        <!-- فایل اصلی -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="فایل اصلی (صدا یا موسیقی اصلی)"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnSelectMain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/select_main_file"
            android:contentDescription="دکمه انتخاب فایل اصلی از حافظه گوشی" />

        <TextView
            android:id="@+id/tvMainFile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/no_file_selected"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            android:contentDescription="نام فایل اصلی انتخاب شده" />

        <Button
            android:id="@+id/btnMainSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="تنظیمات فایل اصلی"
            android:contentDescription="باز کردن تنظیمات فایل اصلی: صدا، سرعت، زیر و بمی، ورود و خروج"
            android:layout_marginBottom="16dp" />

        <!-- فایل پس‌زمینه -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="فایل پس‌زمینه (موسیقی یا صدای پس‌زمینه)"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnSelectBg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/select_bg_file"
            android:contentDescription="دکمه انتخاب فایل پس‌زمینه از حافظه گوشی" />

        <TextView
            android:id="@+id/tvBgFile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/no_file_selected"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            android:contentDescription="نام فایل پس‌زمینه انتخاب شده" />

        <Button
            android:id="@+id/btnBgSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="تنظیمات فایل پس‌زمینه"
            android:contentDescription="باز کردن تنظیمات فایل پس‌زمینه: صدا، سرعت، زیر و بمی، ورود و خروج"
            android:layout_marginBottom="16dp" />

        <!-- فرمت خروجی -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/output_format"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <RadioGroup
            android:id="@+id/rgFormat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <RadioButton
                android:id="@+id/rbMp3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="M4A / AAC"
                android:checked="true"
                android:contentDescription="انتخاب فرمت خروجی M4A" />

            <RadioButton
                android:id="@+id/rbWav"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WAV"
                android:layout_marginStart="24dp"
                android:contentDescription="انتخاب فرمت خروجی WAV" />
        </RadioGroup>

        <!-- دکمه‌های اصلی -->
        <Button
            android:id="@+id/btnMix"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/mix_create"
            android:contentDescription="دکمه میکس و ساخت فایل"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnReset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/reset"
            android:contentDescription="دکمه بازنشانی همه انتخاب‌ها"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnPlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/play_result"
            android:contentDescription="دکمه پخش یا مکث نتیجه"
            android:enabled="false"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/save_to_downloads"
            android:contentDescription="دکمه ذخیره در پوشه دانلودها"
            android:enabled="false" />

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_marginTop="16dp"
            android:max="100"
            android:contentDescription="نوار پیشرفت میکس" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:contentDescription="وضعیت عملیات" />

    </LinearLayout>
</ScrollView>
