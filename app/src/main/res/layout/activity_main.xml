<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ضبط صدا -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ضبط صدا"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btnRecord"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/record_start"
                android:contentDescription="دکمه شروع یا توقف ضبط صدا" />

            <Button
                android:id="@+id/btnDeleteRecord"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="@string/record_delete"
                android:enabled="false"
                android:contentDescription="حذف صدای ضبط شده" />
        </LinearLayout>

        <Button
            android:id="@+id/btnUseRecordAsMain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/record_use_as_main"
            android:enabled="false"
            android:layout_marginBottom="16dp"
            android:contentDescription="استفاده از صدای ضبط شده به عنوان فایل اصلی" />

        <TextView
            android:id="@+id/tvRecordStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:contentDescription="وضعیت ضبط" />

        <!-- فایل اصلی -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="فایل اصلی (صدا یا موسیقی اصلی)"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnSelectMain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/select_main_file"
            android:contentDescription="دکمه انتخاب فایل اصلی از حافظه گوشی" />

        <TextView
            android:id="@+id/tvMainFile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/no_file_selected"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"
            android:contentDescription="نام فایل اصلی انتخاب شده" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/main_volume"
            android:contentDescription="اسلایدر صدای فایل اصلی" />

        <SeekBar
            android:id="@+id/seekMainVolume"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="100"
            android:contentDescription="اسلایدر ولوم فایل اصلی از صفر تا صد" />

        <TextView
            android:id="@+id/tvMainVolume"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="۱۰۰٪"
            android:layout_marginBottom="24dp" />

        <!-- فایل پس‌زمینه -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="فایل پس‌زمینه (موسیقی یا صدای پس‌زمینه)"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnSelectBg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/select_bg_file"
            android:contentDescription="دکمه انتخاب فایل پس‌زمینه از حافظه گوشی" />

        <TextView
            android:id="@+id/tvBgFile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/no_file_selected"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"
            android:contentDescription="نام فایل پس‌زمینه انتخاب شده" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/bg_volume"
            android:contentDescription="اسلایدر صدای فایل پس‌زمینه" />

        <SeekBar
            android:id="@+id/seekBgVolume"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="50"
            android:contentDescription="اسلایدر ولوم فایل پس‌زمینه از صفر تا صد" />

        <TextView
            android:id="@+id/tvBgVolume"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="۵۰٪"
            android:layout_marginBottom="24dp" />

        <!-- دکمه‌های اصلی -->
        <Button
            android:id="@+id/btnMix"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/mix_create"
            android:contentDescription="دکمه میکس و ساخت فایل. پس از انتخاب دو فایل فشار دهید"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnReset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/reset"
            android:contentDescription="دکمه بازنشانی. همه فایل‌های انتخاب شده پاک می‌شوند"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnPlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/play_result"
            android:contentDescription="دکمه پخش یا مکث نتیجه"
            android:enabled="false"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/save_to_downloads"
            android:contentDescription="دکمه ذخیره در پوشه دانلودها"
            android:enabled="false" />

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_marginTop="16dp"
            android:max="100"
            android:contentDescription="نوار پیشرفت میکس" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:contentDescription="وضعیت عملیات" />

    </LinearLayout>
</ScrollView>
